# Read only by `vite build --mode overlay` (envDir = src/overlay).
# The app's API host; boot.ts rewrites calls to it onto the scrollr-tv
# server's /api. Auth is the server's job, so no Logto values here.
VITE_API_URL=https://api.myscrollr.com
VITE_AUTH_ENDPOINT=
VITE_LOGTO_APP_ID=
VITE_SENTRY_DSN=
